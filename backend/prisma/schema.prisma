generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                String               @unique @db.VarChar(100)
  email                   String               @unique @db.VarChar(100)
  password_hash           String               @db.VarChar(255)
  level                   Int?                 @default(1)
  experience              Int?                 @default(0)
  resources               Json?                @default("{\"gems\": 1500, \"gold\": 200, \"rice\": 100, \"stone\": 30, \"lumber\": 50, \"culture\": 20}")
  status                  String?              @default("active") @db.VarChar(20)
  region                  String?              @default("global") @db.VarChar(20)
  premium_pass_active     Boolean?             @default(false)
  premium_expires_at      DateTime?            @db.Timestamp(6)
  last_login              DateTime?            @db.Timestamp(6)
  // MVP2: Era progression
  current_era             String?              @default("Thời Hùng Vương") @db.VarChar(100)
  unlocked_eras           Json?                @default("[\"Thời Hùng Vương\"]")
  // MVP2: Resource synergy (Wu Xing)
  resource_synergy_bonuses Json?               @default("{}")
  // MVP2: Daily story unlocks
  registration_date       DateTime?            @default(now()) @db.Date
  created_at              DateTime?            @default(now()) @db.Timestamp(6)
  updated_at              DateTime?            @default(now()) @updatedAt @db.Timestamp(6)
  daily_quest_progress    DailyQuestProgress[]
  player_provinces        PlayerProvince[]
  player_heroes           PlayerHero[]
  player_resources        PlayerResource[]
  quiz_submissions        QuizSubmission[]
  player_stats            PlayerStats?

  @@map("players")
}

model Province {
  id               Int              @id @db.SmallInt
  name             String           @unique @db.VarChar(100)
  name_english     String?          @db.VarChar(100)
  region           String?          @db.VarChar(100)
  description      String?
  is_capital       Boolean?         @default(false)
  base_gold_rate   Decimal?         @default(100.00) @db.Decimal(10, 2)
  base_rice_rate   Decimal?         @default(100.00) @db.Decimal(10, 2)
  base_wood_rate   Decimal?         @default(80.00) @db.Decimal(10, 2)
  base_stone_rate  Decimal?         @default(100.00) @db.Decimal(10, 2)
  base_bazan_rate  Decimal?         @default(30.00) @db.Decimal(10, 2)
  historical_eras  Json?            @default("[]")
  unlock_order     Int?             @default(99)
  unlock_story_day Int?             @default(0)
  created_at       DateTime?        @default(now()) @db.Timestamp(6)
  updated_at       DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  player_provinces PlayerProvince[]
  stories          Story[]

  @@map("provinces")
}

model Hero {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_vietnamese    String           @db.VarChar(100)
  name_english       String?          @db.VarChar(100)
  era                String?          @db.VarChar(100)
  rarity             String?          @default("common") @db.VarChar(20)
  role               String?          @db.VarChar(50)
  base_hp            Int?             @default(100)
  base_attack        Int?             @default(10)
  base_defense       Int?             @default(5)
  base_speed         Int?             @default(8)
  bonus_type         String?          @db.VarChar(100)
  bonus_value        Int?             @default(0)
  pet_name           String?          @db.VarChar(100)
  pet_emoji          String?          @db.VarChar(10)
  pet_bonus          Int?             @default(0)
  story_day          Int?
  unlock_requirement String?
  is_available       Boolean?         @default(false)
  is_premium         Boolean?         @default(false)
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  updated_at         DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  player_provinces   PlayerProvince[]
  player_heroes      PlayerHero[]     @relation("PlayerHeroToHero")
  stories            Story[]

  @@map("heroes")
}

model Resource {
  id                    String     @id @db.VarChar(50)
  name_vietnamese       String     @db.VarChar(100)
  name_english          String     @db.VarChar(100)
  emoji                 String?    @db.VarChar(10)
  element_type          String     @db.VarChar(20)
  description           String?
  uses                  Json?      @default("[]")
  base_generation_rate  Decimal    @default(1.0) @db.Decimal(10, 2)
  base_storage_capacity Int        @default(500)
  value_points          Int?       @default(1)
  // MVP2: Resource synergy (Wu Xing cycle)
  synergy_gives_to      String?    @db.VarChar(50)
  synergy_bonus_percent Decimal?   @default(10.0) @db.Decimal(5, 2)
  created_at            DateTime?  @default(now()) @db.Timestamp(6)
  updated_at            DateTime?  @default(now()) @updatedAt @db.Timestamp(6)
  buildings             Building[]

  @@index([element_type], map: "idx_resources_element_type")
  @@map("resources")
}

model Building {
  id                        String    @id @db.VarChar(50)
  name_vietnamese           String    @db.VarChar(100)
  name_english              String    @db.VarChar(100)
  description               String?
  building_type             String    @db.VarChar(20)
  produces_resource_id      String?   @db.VarChar(50)
  base_gold_cost            Int?      @default(0)
  base_rice_cost            Int?      @default(0)
  base_wood_cost            Int?      @default(0)
  base_stone_cost           Int?      @default(0)
  base_bazan_cost           Int?      @default(0)
  construction_time_seconds Int       @default(60)
  max_level                 Int       @default(10)
  level_1_production        Int?      @default(0)
  level_1_bonus             Int?      @default(0)
  created_at                DateTime? @default(now()) @db.Timestamp(6)
  updated_at                DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  produces_resource         Resource? @relation(fields: [produces_resource_id], references: [id], onUpdate: NoAction)

  @@index([produces_resource_id], map: "idx_buildings_produces")
  @@index([building_type], map: "idx_buildings_type")
  @@map("buildings")
}

model Story {
  id                   String               @id @db.VarChar(50)
  day                  Int                  @unique
  title_vietnamese     String               @db.VarChar(200)
  title_english        String               @db.VarChar(200)
  content              String
  category             String               @db.VarChar(50)
  era                  String?              @db.VarChar(100)
  province_id          Int?                 @db.SmallInt
  hero_id              String?              @db.Uuid
  reading_time_minutes Int?                 @default(5)
  word_count           Int?                 @default(0)
  base_gold_reward     Int?                 @default(100)
  base_rice_reward     Int?                 @default(100)
  base_wood_reward     Int?                 @default(50)
  is_premium           Boolean?             @default(false)
  is_available         Boolean?             @default(true)
  created_at           DateTime?            @default(now()) @db.Timestamp(6)
  updated_at           DateTime?            @default(now()) @updatedAt @db.Timestamp(6)
  daily_quest_progress DailyQuestProgress[]
  quiz_questions       QuizQuestion[]
  quiz_submissions     QuizSubmission[]
  hero                 Hero?                @relation(fields: [hero_id], references: [id], onUpdate: NoAction)
  province             Province?            @relation(fields: [province_id], references: [id], onUpdate: NoAction)

  @@index([is_available], map: "idx_stories_available")
  @@index([category], map: "idx_stories_category")
  @@index([day], map: "idx_stories_day")
  @@index([hero_id], map: "idx_stories_hero")
  @@index([province_id], map: "idx_stories_province")
  @@map("stories")
}

model QuizQuestion {
  id              String    @id @db.VarChar(100)
  story_id        String    @db.VarChar(50)
  question_number Int
  question        String
  options         Json
  correct_answer  Int
  difficulty      String?   @default("medium") @db.VarChar(20)
  type            String?   @default("comprehension") @db.VarChar(20)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  story           Story     @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([story_id, question_number])
  @@index([difficulty], map: "idx_quiz_difficulty")
  @@index([story_id], map: "idx_quiz_story")
  @@index([type], map: "idx_quiz_type")
  @@map("quiz_questions")
}

model PlayerProvince {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id                 String    @db.Uuid
  province_id               Int       @db.SmallInt
  farmer_level              Int?      @default(1)
  resource_level            Int?      @default(1)
  development_level         Int?      @default(1)
  buildings_count           Int?      @default(0)
  hero_id                   String?   @db.Uuid
  // MVP2: Province skills
  passive_buffs             Json?     @default("[]")
  active_skill_level        Int?      @default(0)
  active_skill_last_used    DateTime? @db.Timestamp(6)
  active_skill_cooldown_ends DateTime? @db.Timestamp(6)
  created_at                DateTime? @default(now()) @db.Timestamp(6)
  updated_at                DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  hero                      Hero?     @relation(fields: [hero_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  player                    Player    @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  province                  Province  @relation(fields: [province_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([player_id, province_id])
  @@index([player_id], map: "idx_player_provinces_player")
  @@index([province_id], map: "idx_player_provinces_province")
  @@map("player_provinces")
}

model PlayerStats {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id          String    @unique @db.Uuid
  stories_read       Int?      @default(0)
  stories_completed  Int?      @default(0)
  quizzes_taken      Int?      @default(0)
  quizzes_passed     Int?      @default(0)
  perfect_quizzes    Int?      @default(0)
  // MVP2: Quiz streaks
  quiz_perfect_streak Int?     @default(0)
  quiz_best_streak   Int?      @default(0)
  total_gold_earned  Int?      @default(0)
  total_rice_earned  Int?      @default(0)
  total_wood_earned  Int?      @default(0)
  total_stone_earned Int?      @default(0)
  total_bazan_earned Int?      @default(0)
  heroes_collected   Int?      @default(0)
  heroes_leveled_up  Int?      @default(0)
  buildings_built    Int?      @default(0)
  buildings_upgraded Int?      @default(0)
  culture_points     Int?      @default(0)
  learning_streak    Int?      @default(0)
  last_story_read_at DateTime? @db.Timestamp(6)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  player             Player    @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([player_id], map: "idx_player_stats_player")
  @@map("player_stats")
}

model DailyQuestProgress {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id      String    @db.Uuid
  quest_date     DateTime  @db.Date
  story_id       String    @db.VarChar(50)
  story_read     Boolean?  @default(false)
  quiz_attempted Boolean?  @default(false)
  quiz_score     Int?      @default(0)
  gold_earned    Int?      @default(0)
  rice_earned    Int?      @default(0)
  wood_earned    Int?      @default(0)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  players        Player    @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  story          Story     @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([player_id, quest_date, story_id])
  @@index([quest_date], map: "idx_daily_quest_date")
  @@index([player_id], map: "idx_daily_quest_player")
  @@index([story_id], map: "idx_daily_quest_story")
  @@map("daily_quest_progress")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model achievements {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(200)
  description       String?
  category          String              @db.VarChar(50)
  rarity            String?             @db.VarChar(20)
  points            Int                 @default(10)
  icon_url          String?             @db.VarChar(255)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  user_achievements user_achievements[]

  @@index([category], map: "idx_achievements_category")
  @@index([rarity], map: "idx_achievements_rarity")
}

model analytics_events {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type  String    @db.VarChar(50)
  player_id   String?   @db.Uuid
  data        Json?
  session_id  String?   @db.VarChar(100)
  device_type String?   @db.VarChar(20)
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at(sort: Desc)], map: "idx_analytics_created")
  @@index([player_id], map: "idx_analytics_player")
  @@index([event_type], map: "idx_analytics_type")
  @@index([event_type, created_at(sort: Desc)], map: "idx_analytics_type_created")
}

model battle_pass_progress {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id       String   @db.Uuid
  season_id       String   @db.Uuid
  tier            Int?     @default(0)
  xp              Int?     @default(0)
  has_premium     Boolean? @default(false)
  claimed_rewards Json?    @default("[]")
  seasons         seasons  @relation(fields: [season_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([player_id, season_id])
  @@index([player_id], map: "idx_bp_progress_player")
  @@index([season_id], map: "idx_bp_progress_season")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model battles {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attacker_id      String    @db.Uuid
  defender_id      String    @db.Uuid
  battle_type      String    @db.VarChar(20)
  result           String?   @db.VarChar(20)
  duration_seconds Int?
  battle_log       Json?
  attacker_reward  Json?
  defender_reward  Json?
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([attacker_id], map: "idx_battles_attacker")
  @@index([created_at(sort: Desc)], map: "idx_battles_created")
  @@index([defender_id], map: "idx_battles_defender")
  @@index([battle_type], map: "idx_battles_type")
}

model daily_metrics {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metric_date   DateTime  @unique @db.Date
  dau           Int       @default(0)
  mau           Int       @default(0)
  d1_retention  Decimal   @default(0) @db.Decimal(5, 2)
  d7_retention  Decimal   @default(0) @db.Decimal(5, 2)
  d30_retention Decimal   @default(0) @db.Decimal(5, 2)
  total_revenue Decimal   @default(0) @db.Decimal(15, 2)
  arpu          Decimal   @default(0) @db.Decimal(10, 2)
  arppu         Decimal   @default(0) @db.Decimal(10, 2)
  paying_users  Int       @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([metric_date(sort: Desc)], map: "idx_daily_metrics_date")
}

model educational_quests {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String           @db.VarChar(200)
  category          String?          @db.VarChar(50)
  dynasty           String?          @db.VarChar(50)
  historical_figure String?          @db.VarChar(100)
  content           String
  description       String?
  quiz              Json
  difficulty        String?          @default("normal") @db.VarChar(20)
  culture_points    Int              @default(100)
  experience_reward Int?             @default(50)
  icon_url          String?          @db.VarChar(255)
  created_at        DateTime?        @default(now()) @db.Timestamp(6)
  quest_progress    quest_progress[]

  @@index([category], map: "idx_quests_category")
  @@index([difficulty], map: "idx_quests_difficulty")
  @@index([dynasty], map: "idx_quests_dynasty")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guild_members {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guild_id            String    @db.Uuid
  player_id           String    @db.Uuid
  rank                String?   @default("member") @db.VarChar(20)
  contribution_points Int?      @default(0)
  joined_at           DateTime? @default(now()) @db.Timestamp(6)
  guilds              guilds    @relation(fields: [guild_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([guild_id, player_id])
  @@index([guild_id], map: "idx_guild_members_guild")
  @@index([player_id], map: "idx_guild_members_player")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guild_wars {
  id                                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attacker_guild_id                           String    @db.Uuid
  defender_guild_id                           String    @db.Uuid
  province_id                                 Int       @db.SmallInt
  status                                      String?   @default("active") @db.VarChar(20)
  result                                      String?   @db.VarChar(20)
  started_at                                  DateTime? @default(now()) @db.Timestamp(6)
  ended_at                                    DateTime? @db.Timestamp(6)
  attacker_participants                       Json?
  defender_participants                       Json?
  guilds_guild_wars_attacker_guild_idToguilds guilds    @relation("guild_wars_attacker_guild_idToguilds", fields: [attacker_guild_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guilds_guild_wars_defender_guild_idToguilds guilds    @relation("guild_wars_defender_guild_idToguilds", fields: [defender_guild_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([attacker_guild_id], map: "idx_wars_attacker")
  @@index([defender_guild_id], map: "idx_wars_defender")
  @@index([province_id], map: "idx_wars_province")
  @@index([status], map: "idx_wars_status")
}

model guilds {
  id                                              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                            String          @unique @db.VarChar(100)
  leader_id                                       String          @db.Uuid
  description                                     String?
  logo_url                                        String?         @db.VarChar(255)
  level                                           Int?            @default(1)
  total_power                                     Int?            @default(0)
  members_count                                   Int?            @default(1)
  treasury                                        Json?           @default("{\"gems\": 0, \"gold\": 0, \"guildCoins\": 0}")
  status                                          String?         @default("active") @db.VarChar(20)
  created_at                                      DateTime?       @default(now()) @db.Timestamp(6)
  updated_at                                      DateTime?       @default(now()) @db.Timestamp(6)
  guild_members                                   guild_members[]
  guild_wars_guild_wars_attacker_guild_idToguilds guild_wars[]    @relation("guild_wars_attacker_guild_idToguilds")
  guild_wars_guild_wars_defender_guild_idToguilds guild_wars[]    @relation("guild_wars_defender_guild_idToguilds")

  @@index([leader_id], map: "idx_guilds_leader")
  @@index([level(sort: Desc)], map: "idx_guilds_level")
  @@index([total_power(sort: Desc)], map: "idx_guilds_power")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leaderboard_entries {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id   String    @db.Uuid
  board_type  String    @db.VarChar(20)
  rank        Int
  score       Int
  region      String?   @default("global") @db.VarChar(20)
  timeframe   String?   @default("all_time") @db.VarChar(20)
  rank_change Int?      @default(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  @@index([player_id], map: "idx_leaderboard_player")
  @@index([region], map: "idx_leaderboard_region")
  @@index([board_type, rank], map: "idx_leaderboard_type_rank")
  @@index([updated_at(sort: Desc)], map: "idx_leaderboard_updated")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model marketplace_listings {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id                String                     @db.Uuid
  item_id                  String                     @db.VarChar(100)
  item_name                String                     @db.VarChar(200)
  item_type                String                     @db.VarChar(50)
  item_data                Json?
  price                    Int
  status                   String?                    @default("active") @db.VarChar(20)
  auction_start            DateTime?                  @default(now()) @db.Timestamp(6)
  auction_end              DateTime?                  @db.Timestamp(6)
  buyer_id                 String?                    @db.Uuid
  sold_at                  DateTime?                  @db.Timestamp(6)
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  expires_at               DateTime?                  @db.Timestamp(6)
  marketplace_transactions marketplace_transactions[]

  @@index([expires_at], map: "idx_listings_expires")
  @@index([item_type], map: "idx_listings_item_type")
  @@index([price], map: "idx_listings_price")
  @@index([seller_id], map: "idx_listings_seller")
  @@index([status], map: "idx_listings_status")
}

model marketplace_transactions {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id           String               @db.Uuid
  buyer_id             String               @db.Uuid
  seller_id            String               @db.Uuid
  price                Int
  fee_amount           Int                  @default(0)
  net_amount           Int                  @default(0)
  status               String?              @default("completed") @db.VarChar(20)
  created_at           DateTime?            @default(now()) @db.Timestamp(6)
  marketplace_listings marketplace_listings @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([buyer_id], map: "idx_transactions_buyer")
  @@index([created_at(sort: Desc)], map: "idx_transactions_created")
  @@index([seller_id], map: "idx_transactions_seller")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model moderation_actions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id     String    @db.Uuid
  moderator_id  String?   @db.Uuid
  action_type   String    @db.VarChar(20)
  reason        String
  duration_days Int?
  expires_at    DateTime? @db.Timestamp(6)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([is_active], map: "idx_moderation_active")
  @@index([expires_at], map: "idx_moderation_expires")
  @@index([player_id], map: "idx_moderation_player")
}

model pets {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id   String    @db.Uuid
  name        String    @db.VarChar(100)
  pet_type    String?   @db.VarChar(50)
  rarity      String?   @db.VarChar(20)
  level       Int?      @default(1)
  experience  Int?      @default(0)
  acquired_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([player_id], map: "idx_pets_player")
}

model quest_progress {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id          String             @db.Uuid
  quest_id           String             @db.Uuid
  attempts           Int?               @default(0)
  best_score         Int?               @default(0)
  completed_at       DateTime?          @db.Timestamp(6)
  educational_quests educational_quests @relation(fields: [quest_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([player_id, quest_id])
  @@index([completed_at], map: "idx_quest_progress_completed")
  @@index([player_id], map: "idx_quest_progress_player")
  @@index([quest_id], map: "idx_quest_progress_quest")
}

model seasons {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @db.VarChar(100)
  theme                String?                @db.VarChar(50)
  number               Int                    @unique
  start_date           DateTime               @db.Timestamp(6)
  end_date             DateTime               @db.Timestamp(6)
  is_active            Boolean?               @default(true)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  battle_pass_progress battle_pass_progress[]

  @@index([is_active], map: "idx_seasons_active")
  @@index([start_date, end_date], map: "idx_seasons_dates")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id          String    @db.Uuid
  transaction_type   String    @db.VarChar(50)
  amount             Decimal   @db.Decimal(15, 2)
  currency           String?   @default("VND") @db.VarChar(10)
  item_id            String?   @db.VarChar(100)
  item_name          String?   @db.VarChar(200)
  payment_method     String?   @db.VarChar(50)
  status             String?   @default("pending") @db.VarChar(20)
  external_reference String?   @db.VarChar(255)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  completed_at       DateTime? @db.Timestamp(6)

  @@index([player_id], map: "idx_transactions_player")
  @@index([status], map: "idx_transactions_status")
  @@index([transaction_type], map: "idx_transactions_type")
}

model user_achievements {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id      String       @db.Uuid
  achievement_id String       @db.Uuid
  progress       Int?         @default(0)
  unlocked_at    DateTime?    @db.Timestamp(6)
  achievements   achievements @relation(fields: [achievement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([player_id, achievement_id])
  @@index([player_id], map: "idx_user_achievements_player")
  @@index([unlocked_at], map: "idx_user_achievements_unlocked")
}

// ============================================================================
// MVP1 ADDITIONAL MODELS
// ============================================================================

model PlayerHero {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id           String    @db.Uuid
  hero_id             String    @db.Uuid
  level               Int?      @default(1)
  experience          Int?      @default(0)
  deployed_to         Int?      @db.SmallInt
  // MVP2: Hero leveling system (1-5)
  level_up_cost       Json?     @default("{\"gold\": 0, \"gems\": 0}")
  current_hp          Int?
  current_attack      Int?
  current_defense     Int?
  current_speed       Int?
  // MVP2: Pet system
  pet_level           Int?      @default(1)
  pet_bonus_active    Boolean?  @default(true)
  pet_evolution_stage Int?      @default(1)
  acquired_at         DateTime? @default(now()) @db.Timestamp(6)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  player              Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)
  hero                Hero      @relation("PlayerHeroToHero", fields: [hero_id], references: [id], onDelete: Cascade)

  @@unique([player_id, hero_id])
  @@index([player_id], map: "idx_player_heroes_player")
  @@index([hero_id], map: "idx_player_heroes_hero")
  @@map("player_heroes")
}

model PlayerResource {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id       String    @db.Uuid
  resource_type   String    @db.VarChar(50)
  amount          Int       @default(0)
  last_harvest_at DateTime? @db.Timestamp(6)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  player          Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@unique([player_id, resource_type])
  @@index([player_id], map: "idx_player_resources_player")
  @@index([resource_type], map: "idx_player_resources_type")
  @@map("player_resources")
}

model QuizSubmission {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id   String    @db.Uuid
  story_id    String    @db.VarChar(50)
  score       Int       @default(0)
  max_score   Int       @default(0)
  answers     Json?
  time_taken  Int?      // seconds
  multiplier  Decimal?  @db.Decimal(5, 2)
  rewards     Json?
  submitted_at DateTime? @default(now()) @db.Timestamp(6)
  player      Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)
  story       Story     @relation(fields: [story_id], references: [id], onDelete: Cascade)

  @@index([player_id], map: "idx_quiz_submissions_player")
  @@index([story_id], map: "idx_quiz_submissions_story")
  @@index([submitted_at(sort: Desc)], map: "idx_quiz_submissions_date")
  @@map("quiz_submissions")
}
