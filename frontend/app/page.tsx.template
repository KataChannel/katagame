/**
 * INTEGRATION STEPS FOR REAL DATA:
 * 
 * 1. Import MVP1ApiClient and useGameData hook
 * 2. In Game component, load real data on mount
 * 3. Replace hardcoded mock data with real API responses
 * 4. Update state when real data arrives
 * 5. Pass real data to child components
 * 6. Handle loading/error states
 * 
 * Expected changes:
 * - NO more initialProvinces hardcoded array
 * - NO more mock stories in CultureCenter
 * - NO more mock heroes in store
 * - ALL data comes from MVP1 backend endpoints
 */

export default function Game() {
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [authToken, setAuthToken] = useState<string | null>(null);
  const [currentUser, setCurrentUser] = useState<any>(null);
  const [activeTab, setActiveTab] = useState<'game' | 'premium' | 'shop' | 'culture' | 'achievements' | 'settings' | 'combat' | 'heroes' | 'pets' | 'battlepass' | 'gacha' | 'guild' | 'arena' | 'worldmap' | 'missions' | 'friends' | 'enhancedshop' | 'customization' | 'analytics' | 'multiplayer' | 'marketplace'>('game');
  const [showTutorial, setShowTutorial] = useState(false);
  const [isLoading, setIsLoading] = useState(true);
  
  // ✅ NEW: Load real data from MVP1 backend
  const { 
    stories: realStories,
    resources: realResources,
    heroes: realHeroes,
    provinces: realProvinces,
    playerResources: realPlayerResources,
    playerHeroes: realPlayerHeroes,
    playerProvinces: realPlayerProvinces,
    gameConfig,
    isLoading: isLoadingGameData,
    error: gameDataError
  } = useGameData();
  
  const { 
    player, 
    provinces, 
    gameSpeed, 
    setGameSpeed, 
    tutorial, 
    completeTutorial, 
    notifications,
    checkAndResetMissions,
    checkAndResetFriendGifts,
    checkAndRefreshShops,
  } = useGameStore();
  const { NotificationComponent } = useNotifications();

  // ✅ NEW: Initialize API client and load real data on mount
  useEffect(() => {
    const token = localStorage.getItem('authToken');
    const user = localStorage.getItem('user');
    
    if (token && user) {
      setAuthToken(token);
      setCurrentUser(JSON.parse(user));
      setIsAuthenticated(true);
      
      // ✅ Set API token for all MVP1 API calls
      MVP1ApiClient.setAuthToken(token);
    }
  }, []);

  // ✅ NEW: Update game state with real data when it arrives
  useEffect(() => {
    if (isAuthenticated && !isLoadingGameData && realProvinces && realPlayerProvinces) {
      const initGame = async () => {
        try {
          // ✅ Merge real data with game state
          // You can create a function to update Zustand store with real data
          // For now, we'll keep using the hook data directly in components
          
          await new Promise(resolve => setTimeout(resolve, 500));
          setIsLoading(false);
          
          // Show tutorial for new players if applicable
          if (!tutorial.completed && player.level === 1 && player.experience === 0) {
            setTimeout(() => setShowTutorial(true), 500);
          }
          
          // Check and reset missions on app start
          checkAndResetMissions();
          checkAndResetFriendGifts();
          checkAndRefreshShops();
          initializeStorageOptimization();
        } catch (error) {
          console.error('Error initializing game:', error);
          setIsLoading(false);
        }
      };
      
      initGame();
    } else if (!isAuthenticated) {
      setIsLoading(false);
    }
  }, [isAuthenticated, isLoadingGameData, realProvinces, realPlayerProvinces, tutorial.completed, player.level, player.experience, checkAndResetMissions, checkAndResetFriendGifts, checkAndRefreshShops]);

  // ✅ NEW: Show error if data loading failed
  if (gameDataError && isAuthenticated) {
    return (
      <div className="error-container">
        <h1>Error Loading Game Data</h1>
        <p>{gameDataError}</p>
        <button onClick={() => window.location.reload()}>Retry</button>
      </div>
    );
  }

  if (!isAuthenticated) {
    return <AuthPage onAuthenticate={(token, user) => {
      setAuthToken(token);
      setCurrentUser(user);
      setIsAuthenticated(true);
      MVP1ApiClient.setAuthToken(token);
    }} />;
  }

  if (isLoading || isLoadingGameData) {
    return <LoadingScreen />;
  }

  return (
    <AppErrorBoundary>
      <div className="game-container">
        {/* Desktop Navigation */}
        <DesktopNav 
          activeTab={activeTab}
          onTabChange={setActiveTab}
        />

        <div className="main-content">
          {/* ✅ PASS REAL DATA TO COMPONENTS */}
          
          {activeTab === 'game' && (
            <div className="game-tab">
              {/* ✅ Use real resources from MVP1 API */}
              <MobileResourceBar 
                resources={realPlayerResources}
              />

              {/* ✅ Use real provinces from MVP1 API */}
              <div className="provinces-grid">
                {realPlayerProvinces?.map(province => (
                  <MobileProvinceCard 
                    key={province.id}
                    province={province}
                    // Province data is now real from backend
                  />
                ))}
              </div>

              {/* Game Loop */}
              <GameLoop gameSpeed={gameSpeed} />

              {/* Player Info */}
              <PlayerInfo player={player} />
            </div>
          )}

          {activeTab === 'culture' && (
            <CultureCenter 
              stories={realStories}  {/* ✅ Real stories from MVP1 API */}
              // CultureCenter will load quiz data on demand using MVP1ApiClient
            />
          )}

          {activeTab === 'heroes' && (
            <HeroesTab 
              allHeroes={realHeroes}  {/* ✅ Real heroes from MVP1 API */}
              myHeroes={realPlayerHeroes}  {/* ✅ Real player heroes */}
              resources={realPlayerResources}  {/* ✅ Real resources */}
              // HeroesTab will use MVP1ApiClient.recruitHero() and deployHero()
            />
          )}

          {activeTab === 'combat' && (
            <CombatTab 
              heroes={realPlayerHeroes}
              resources={realPlayerResources}
            />
          )}

          {activeTab === 'premium' && (
            <PremiumPass />
          )}

          {activeTab === 'shop' && (
            <Shop />
          )}

          {activeTab === 'achievements' && (
            <Achievements />
          )}

          {activeTab === 'settings' && (
            <SettingsPanel 
              onGameSpeedChange={setGameSpeed}
              gameSpeed={gameSpeed}
            />
          )}

          {activeTab === 'pets' && (
            <PetsTab />
          )}

          {activeTab === 'battlepass' && (
            <BattlePassTab />
          )}

          {activeTab === 'gacha' && (
            <GachaTab />
          )}

          {activeTab === 'guild' && (
            <GuildTab />
          )}

          {activeTab === 'arena' && (
            <ArenaTab />
          )}

          {activeTab === 'worldmap' && (
            <WorldMapTab />
          )}

          {activeTab === 'missions' && (
            <DailyMissionsTab />
          )}

          {activeTab === 'friends' && (
            <FriendsTab />
          )}

          {activeTab === 'enhancedshop' && (
            <EnhancedShopTab />
          )}

          {activeTab === 'customization' && (
            <CustomizationTab />
          )}

          {activeTab === 'analytics' && (
            <AnalyticsTab />
          )}

          {activeTab === 'multiplayer' && (
            <MultiplayerTab />
          )}

          {activeTab === 'marketplace' && (
            <MarketplaceTab />
          )}
        </div>

        {/* Mobile Bottom Navigation */}
        <MobileBottomNav 
          activeTab={activeTab}
          onTabChange={setActiveTab}
        />

        {/* Tutorial Overlay */}
        {showTutorial && (
          <Tutorial 
            onComplete={() => {
              setShowTutorial(false);
              completeTutorial();
            }}
          />
        )}

        {/* Notifications */}
        <NotificationComponent />
      </div>
    </AppErrorBoundary>
  );
}

