```bash
# KataGame Backend Environment Configuration
# Copy this file to .env.local and customize for your environment

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# For Docker Compose (default)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/katagame

# For Local PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/katagame

# For AWS RDS
# DATABASE_URL=postgresql://username:password@your-endpoint.rds.amazonaws.com:5432/katagame

# For Heroku
# DATABASE_URL=<paste-heroku-postgresql-url>

# Database connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_TIMEOUT=2000

# ===========================================
# JWT AUTHENTICATION
# ===========================================

# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345678901234567890

# Token expiry in hours
JWT_EXPIRY=24h

# ===========================================
# REDIS CACHE (Optional)
# ===========================================

# For Docker Compose
REDIS_URL=redis://redis:6379/0

# For Local Redis
# REDIS_URL=redis://localhost:6379/0

REDIS_DB=0

# ===========================================
# MOTIA FRAMEWORK
# ===========================================

# Development | Staging | Production
MOTIA_ENV=development

# Logging: debug | info | warn | error
MOTIA_LOG_LEVEL=debug

# Event processing
MOTIA_MAX_RETRIES=3
MOTIA_RETRY_DELAY=5000

# ===========================================
# SERVER
# ===========================================

# development | production
NODE_ENV=development

# Server port and host
PORT=11001
HOST=0.0.0.0

# ===========================================
# LOGGING
# ===========================================

# info | debug | warn | error
LOG_LEVEL=info

# json | text
LOG_FORMAT=json

# ===========================================
# FEATURE FLAGS
# ===========================================

# Game Systems
ENABLE_GUILD_WARS=true
ENABLE_MARKETPLACE=true
ENABLE_QUESTS=true
ENABLE_ANALYTICS=true
ENABLE_ACHIEVEMENTS=true

# Experimental Features
FEATURE_NEW_BATTLE_SYSTEM=false
FEATURE_PVE_DUNGEONS=false
FEATURE_REAL_TIME_LEADERBOARD=false

# ===========================================
# RATE LIMITING
# ===========================================

# Time window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=1000

# ===========================================
# CORS
# ===========================================

# Frontend URL
CORS_ORIGIN=http://localhost:11000

# Allow credentials in CORS
CORS_CREDENTIALS=true

# ===========================================
# ANALYTICS
# ===========================================

# Enable analytics collection
ANALYTICS_ENABLED=true

# Sample rate: 0.0 to 1.0 (1.0 = 100%)
ANALYTICS_SAMPLE_RATE=1.0

# ===========================================
# MONITORING & METRICS
# ===========================================

# Enable monitoring
MONITORING_ENABLED=true

# Prometheus metrics port
METRICS_PORT=9090

# ===========================================
# API ENDPOINTS
# ===========================================

# Backend API base URL (for documentation)
API_BASE_URL=http://localhost:11001/api/v1

# Frontend URL (for documentation links)
FRONTEND_URL=http://localhost:11000

# ===========================================
# THIRD-PARTY INTEGRATIONS
# ===========================================

# Google OAuth (for Sign-In with Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=897974685698-621ekaodhnha7ssfaml6m1u418ab2ucq.apps.googleusercontent.com

# Email Service (for notifications)
# SENDGRID_API_KEY=your-sendgrid-key

# Payment Processing (for premium features)
# STRIPE_SECRET_KEY=your-stripe-key
# STRIPE_PUBLIC_KEY=your-stripe-public-key

# Analytics Service (for external analytics)
# MIXPANEL_TOKEN=your-mixpanel-token

# ===========================================
# SECURITY
# ===========================================

# Password hashing salt rounds
PASSWORD_SALT_ROUNDS=10

# Session timeout in minutes
SESSION_TIMEOUT=60

# Max login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
LOCKOUT_DURATION=15

```
