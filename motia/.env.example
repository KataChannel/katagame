# KataGame Backend Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/katagame
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_TIMEOUT=2000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Redis (for caching and state)
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Motia
MOTIA_ENV=development
MOTIA_LOG_LEVEL=debug
MOTIA_MAX_RETRIES=3
MOTIA_RETRY_DELAY=5000

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Features
ENABLE_GUILD_WARS=true
ENABLE_MARKETPLACE=true
ENABLE_QUESTS=true
ENABLE_ANALYTICS=true
ENABLE_ACHIEVEMENTS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=1.0

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090

# Feature Flags
FEATURE_NEW_BATTLE_SYSTEM=false
FEATURE_PVE_DUNGEONS=false
FEATURE_REAL_TIME_LEADERBOARD=false
