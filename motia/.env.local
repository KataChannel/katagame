# Development Environment
DATABASE_URL=postgresql://postgres:postgres@localhost:11003/katagame
DATABASE_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT=30000
DATABASE_TIMEOUT=2000

JWT_SECRET=dev-jwt-secret-change-in-production-9a7f8e6d5c4b3a2f1e0d9c8b7a6f5e4d
JWT_EXPIRY=24h

REDIS_URL=redis://localhost:6379
REDIS_DB=0

MOTIA_ENV=development
MOTIA_LOG_LEVEL=debug
MOTIA_MAX_RETRIES=3
MOTIA_RETRY_DELAY=5000

NODE_ENV=development
PORT=11001
HOST=0.0.0.0

LOG_LEVEL=debug
LOG_FORMAT=json

ENABLE_GUILD_WARS=true
ENABLE_MARKETPLACE=true
ENABLE_QUESTS=true
ENABLE_ANALYTICS=true
ENABLE_ACHIEVEMENTS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

CORS_ORIGIN=http://localhost:11000,http://localhost:11001
CORS_CREDENTIALS=true

ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=1.0

MONITORING_ENABLED=true
METRICS_PORT=9090

FEATURE_NEW_BATTLE_SYSTEM=false
FEATURE_PVE_DUNGEONS=false
FEATURE_REAL_TIME_LEADERBOARD=false
